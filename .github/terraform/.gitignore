# Local .terraform directories and provider binaries
**/.terraform/*
.terraform/

# State files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Sensitive variable files (preserve example file)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI plan files
*.tfplan
